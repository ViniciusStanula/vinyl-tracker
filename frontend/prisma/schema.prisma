generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Disco {
  id        String   @id @default(uuid())
  asin      String   @unique
  titulo    String
  artista   String
  slug      String   @unique
  estilo    String?
  imgUrl    String?
  url       String
  rating      Decimal? @db.Decimal(3, 1)
  reviewCount Int?
  disponivel  Boolean  @default(true)
  priceCount  Int      @default(0)    @map("price_count")
  avg30d      Decimal? @db.Decimal(10, 2) @map("avg_30d")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  precos HistoricoPreco[]

  @@index([artista])
  @@index([titulo])
  @@index([estilo])
  @@index([slug])
}

model ArtistMeta {
  artista      String   @id
  mbid         String?
  wikidataUrl  String?  @map("wikidata_url")
  wikipediaUrl String?  @map("wikipedia_url")
  spotifyUrl   String?  @map("spotify_url")
  enrichedAt   DateTime @default(now()) @map("enriched_at")

  @@map("ArtistMeta")
}

model HistoricoPreco {
  id          String   @id @default(uuid())
  discoId     String
  disco       Disco    @relation(fields: [discoId], references: [id], onDelete: Cascade)
  precoBrl    Decimal  @db.Decimal(10, 2)
  capturadoEm DateTime @default(now())

  @@index([discoId, capturadoEm(sort: Desc)])
  @@index([capturadoEm(sort: Desc)])
}

model HreflangSlug {
  type String
  slug String

  @@id([type, slug])
  @@map("HreflangSlug")
}

model HreflangRecord {
  asin      String   @id
  peerSlug  String   @map("peer_slug")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("HreflangRecord")
}
