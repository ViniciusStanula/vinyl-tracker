generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Disco {
  id        String   @id @default(uuid())
  asin      String   @unique
  titulo    String
  artista   String
  slug      String   @unique
  estilo    String?
  imgUrl    String?
  url       String
  rating      Decimal? @db.Decimal(3, 1)
  reviewCount Int?
  disponivel  Boolean  @default(true)
  priceCount  Int      @default(0)    @map("price_count")
  // NULL = unverified; "vinyl" = confirmed; anything else = excluded (CD incident 2026-06-11)
  format      String?
  // Price/link source: "amazon" (default) or "mercadolivre". Fences Amazon-only crawler jobs.
  marketplace String   @default("amazon")
  avg30d      Decimal? @db.Decimal(10, 2) @map("avg_30d")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  precos HistoricoPreco[]

  @@index([artista])
  @@index([titulo])
  @@index([estilo])
  @@index([slug])
  @@index([marketplace])
}

model ArtistMeta {
  artista      String   @id
  mbid         String?
  wikidataUrl  String?  @map("wikidata_url")
  wikipediaUrl String?  @map("wikipedia_url")
  spotifyUrl   String?  @map("spotify_url")
  // ISO 3166-1 alpha-2 country code of the artist's origin, from MusicBrainz.
  country      String?
  enrichedAt   DateTime @default(now()) @map("enriched_at")

  @@map("ArtistMeta")
}

model HistoricoPreco {
  id          String   @id @default(uuid())
  discoId     String
  disco       Disco    @relation(fields: [discoId], references: [id], onDelete: Cascade)
  precoBrl    Decimal  @db.Decimal(10, 2)
  capturadoEm DateTime @default(now())

  @@index([discoId, capturadoEm(sort: Desc)])
  @@index([capturadoEm(sort: Desc)])
}

model HreflangSlug {
  type String
  slug String

  @@id([type, slug])
  @@map("HreflangSlug")
}

model HreflangRecord {
  asin      String   @id
  peerSlug  String   @map("peer_slug")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("HreflangRecord")
}

// Bot/crawler hit log. Rows are inserted via the Supabase REST API from
// proxy.ts (anon key + insert-only RLS policy), NOT via Prisma Client —
// so every default must be a DB-level default (autoincrement/now()),
// never a client-side one like uuid().
// RLS, policies and grants are NOT managed by `prisma db push`; see the
// one-time SQL in the bot-logging setup notes.
model BotHit {
  id             BigInt   @id @default(autoincrement())
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  path           String
  query          String?
  userAgent      String   @map("user_agent")
  botName        String?  @map("bot_name")
  botCategory    String?  @map("bot_category")
  method         String
  status         Int?
  ip             String?
  country        String?
  region         String?
  city           String?
  referer        String?
  acceptLanguage String?  @map("accept_language")
  // Vercel request id (x-vercel-id); same across a request's log lines.
  // Backed by a PARTIAL unique index (WHERE request_id IS NOT NULL) applied via
  // raw SQL, so duplicate deliveries of one request are dropped on insert.
  requestId      String?  @map("request_id")

  @@index([createdAt(sort: Desc)])
  @@index([botName])
  @@index([path])
  @@map("bot_hits")
}
