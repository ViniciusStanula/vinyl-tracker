NEXT_PUBLIC_SITE_URL="https://seu-dominio.vercel.app"

# On-demand cache purge — used by /api/revalidate to authenticate the crawler webhook.
# Must match REVALIDATE_SECRET in crawler/.env and in Vercel project env vars.
#   Generate: python -c "import secrets; print(secrets.token_hex(32))"
REVALIDATE_SECRET=""

# Supabase — Transaction Pooler (porta 6543) — usado pelo Next.js em produção
DATABASE_URL="postgresql://postgres.[ref]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase — Direct connection — usado APENAS para migrations (npx prisma db push)
DIRECT_URL="postgresql://postgres:[SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres"

# Last.fm API — carrossel "Artistas mais Ouvidos"
# Obtenha em: https://www.last.fm/api/account/create
LASTFM_API_KEY=""

# Supabase REST — usado pelo proxy.ts para registrar hits de bots/crawlers
# na tabela bot_hits (insert fire-and-forget via API REST, chave anon +
# política RLS insert-only). Precisam estar configuradas também no Vercel.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
