# Supabase — Transaction Pooler (porta 6543)
# Settings → Database → Connection string → URI → Transaction pooler
DATABASE_URL="postgresql://postgres.[ref]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Amazon Associates affiliate tag — leave empty to omit the tag from URLs
ASSOCIATE_TAG="garimpavinil-20"

# Last.fm API key — used to enrich artists with genre tags
# Create one at https://www.last.fm/api/account/create (free)
LASTFM_API_KEY=""

# Anthropic API key — used by generate_seo_content.py for bio generation
# Get one at https://console.anthropic.com (claude-haiku-4-5 for artists)
ANTHROPIC_API_KEY=""

# ── Creators API (refresh path: Phase 0 deal re-validation + Phase 3 stale) ──
# New rotated credentials from Associates Central → Tools → Creators API.
# PA-API is retired (2026-05-15); these replace it. v3.1 = Login-with-Amazon.
CREATORS_CLIENT_ID="amzn1.application-oa2-client.xxxx"
CREATORS_CLIENT_SECRET="amzn1.oa2-cs.v1.xxxx"
CREATORS_CREDENTIAL_VERSION="v3.1"
# Rate limiter — TWO independent knobs (TPD is NOT derived from TPS).
CREATORS_TPS="1"        # instantaneous requests/sec (floor placeholder)
CREATORS_TPD="8640"     # UTC-day request budget, now enforced ACROSS runs via api_budget_ledger
CREATORS_TPD_PER_RUN="1000"  # per-run cap; 8 runs * 1000 < day cap, so Phase-0 deals never starve
CREATORS_API_WORKERS="8"     # parallel getItems; shared TPS bucket still caps real rate at <= TPS

# ── Refresh-migration behaviour ──
FRESHNESS_FLOOR_MINUTES="180"   # skip records refreshed more recently than this
AMAZON_MAX_CONCURRENCY="4"      # global cap on simultaneous storefront scraper hits

# Master switch: route Phase 0 + Phase 3 refresh through the Creators API.
# Leave OFF until shadow parity PASSES; OFF keeps the scraper-based refresh.
# CREATORS_REFRESH_ENABLED="1"

# Step F discovery trim (optional): widen the stale/discovery session-rotation
# interval once refresh is off the scraper. Default (unset) = (1,4). Widen ONLY
# while watching crawl_run_metrics skeleton/blocked rate; revert if it climbs.
# STALE_ROTATE_MIN="4"
# STALE_ROTATE_MAX="10"
# AMAZON_SCRAPE_LOCK_TTL_S="2700"   # scrape-lock TTL (crash-safe auto-release)

# Revalidation hook (Next.js on-demand cache purge after a successful crawl)
REVALIDATE_URL=""
REVALIDATE_SECRET=""

# Residential proxy pool for the discovery scraper (comma-separated URLs).
# Format: http://user:pass@host:port — leave empty to use the runner IP.
PROXY_LIST=""
